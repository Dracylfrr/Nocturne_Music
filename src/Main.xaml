<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nocturne" Width="1180" Height="780" MinWidth="850" MinHeight="560" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#000000" Foreground="#F2F2F2" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#333333"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Muted" Color="#969696"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Background" Value="#1B1B1B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#333333"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Background" Value="#171717"/><Setter Property="BorderBrush" Value="#333333"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="TreeViewItem">
   <Setter Property="Foreground" Value="#E4E4E4"/>
   <Setter Property="IsExpanded" Value="True"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TreeViewItem">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" VerticalAlignment="Center" Focusable="False" AutomationProperties.Name="Expand or collapse section">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent" Padding="4,8"><TextBlock x:Name="Chevron" Text="›" Foreground="#9C9C9C" FontSize="14"/></Border>
          <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄"/></Trigger></ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <Border x:Name="Card" Grid.Column="1" Background="#141414" BorderBrush="#242424" BorderThickness="1" CornerRadius="8" Margin="0,0,4,5" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
        <ContentPresenter x:Name="HeaderHost" ContentSource="Header" HorizontalAlignment="Stretch"/>
       </Border>
       <ItemsPresenter x:Name="Children" Grid.Row="1" Grid.Column="1" Margin="4,0,0,0"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
       <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed"/></Trigger>
       <Trigger SourceName="Card" Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#202020"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#27231C"/><Setter TargetName="Card" Property="BorderBrush" Value="#796037"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#BC9760"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Padding" Value="12,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#303030"/></Trigger></Style.Triggers></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Margin" Value="0,10"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Background" Value="#1B1B1B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8"><DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Margin="12,0,0,0"/><ContentPresenter/></DockPanel></Border></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding SelectionBoxItem}"/></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="#1B1B1B" CornerRadius="6" Padding="4" MinWidth="145"><ItemsPresenter/></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="#1B1B1B"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="108"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="#080808" Grid.Row="0"><DockPanel Margin="16,0,8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#FFFFFF" FontSize="19"/><TextBlock x:Name="AppName" Text="  nocturne" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="MiniLabel" Text="  /  MINI PLAYER" Foreground="#969696" FontSize="10" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Minimize" Content="−" ToolTip="Minimize" Background="Transparent"/><Button x:Name="Compact" Content="□" ToolTip="Toggle mini-player" Background="Transparent"/><Button x:Name="CloseApp" Content="✕" ToolTip="Quit Nocturne" Background="Transparent"/></StackPanel></DockPanel></Border>
  <Grid x:Name="LibraryView" Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="258"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#080808" BorderBrush="#242424" BorderThickness="0,0,1,0"><DockPanel Margin="16,22,12,16">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="YOUR LIBRARY" Foreground="#969696" FontSize="10" FontWeight="Bold" Margin="10,0,0,14"/><Button x:Name="AllMusic" Content="♫   All music" HorizontalContentAlignment="Left"/><Button x:Name="Artists" Content="◎   Artists"/><DockPanel Margin="10,24,12,8"><TextBlock x:Name="FavoritesCount" DockPanel.Dock="Right" Text="0" Foreground="#B0B0B0" FontSize="10" FontWeight="SemiBold" AutomationProperties.Name="Favorite track count"/><TextBlock Text="FAVORITES" Foreground="#969696" FontSize="10" FontWeight="Bold"/></DockPanel><Button x:Name="Favorites" Content="★   Favorite tracks" HorizontalContentAlignment="Left"/><DockPanel x:Name="SectionsHeader" Background="Transparent" AllowDrop="True" Margin="7,20,0,8"><Button x:Name="NewFolder" DockPanel.Dock="Right" Content="+" ToolTip="New section" AutomationProperties.Name="New section" Padding="9,3" Margin="2,0"/><TextBlock x:Name="SectionsRoot" Text="SECTIONS" Background="Transparent" Foreground="#969696" FontSize="10" FontWeight="Bold" VerticalAlignment="Stretch" Padding="3,5" ToolTip="Drop a section here to move it to the library level"/></DockPanel></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Button x:Name="Import" Content="＋  Import"/><Button x:Name="Settings" Content="⚙  Settings" Background="Transparent"/></StackPanel>
    <TreeView x:Name="Folders" Background="Transparent" BorderThickness="0" Margin="0,0,0,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"/>
   </DockPanel></Border>
   <Grid Grid.Column="1" Margin="28,24,28,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Button x:Name="RefreshLibrary" DockPanel.Dock="Right" Content="↻  Refresh" ToolTip="Scan for added or changed songs"/><Grid Margin="0,3,10,3"><TextBox x:Name="Search" ToolTip="Search titles, artists, or sections"/><TextBlock Text="Search music, artists, or sections" Foreground="#969696" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
    <Grid Grid.Row="1" Margin="0,26,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#171717" CornerRadius="14" Width="96" Height="96" HorizontalAlignment="Left"><Grid><TextBlock Text="♫" FontSize="42" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/><Image x:Name="SectionCover" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="Breadcrumb" Text="LIBRARY" Foreground="#B0B0B0" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="SectionTitle" Text="All music" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,6"/><TextBlock x:Name="SectionInfo" Text="A little space for everything you listen to." Foreground="#969696"/></StackPanel></Grid>
    <DockPanel Grid.Row="2" Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SectionArt" Content="Artwork"/><Button x:Name="OpenFolder" Content="Open folder"/><Button x:Name="DeleteSection" Content="Delete section…" IsEnabled="False"/><ComboBox x:Name="Sort" Width="145" Margin="6,3,0,3" SelectedIndex="0"><ComboBoxItem Content="A → Z"/><ComboBoxItem Content="Recently added"/></ComboBox></StackPanel><Button x:Name="PlaySection" Content="▶  Play section" Background="#343434" HorizontalAlignment="Left"/></DockPanel>
    <Grid Grid.Row="3"><ListBox x:Name="Tracks" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><Button Grid.Column="0" Tag="Favorite" Content="{Binding FavoriteStar}" ToolTip="{Binding FavoriteAction}" Background="Transparent" Foreground="#FFCD69" Padding="6,4" FontSize="18" Margin="3,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding FavoriteAction}"/><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Section}" Foreground="#969696" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Artist}" Foreground="#B9B9B9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding AddedLabel}" ToolTip="{Binding AddedDetail}" Foreground="#969696" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="EmptyTitle" Text="Your next favorite belongs here." FontSize="20" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="Import music, create a section, and organize your favorite tracks." Foreground="#969696" Margin="0,12,0,0" TextAlignment="Center"/></StackPanel></Grid>
    <TextBlock x:Name="Status" Grid.Row="4" Text="Ready" Foreground="#969696" FontSize="11" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#0C0C0C" BorderBrush="#282828" BorderThickness="0,1,0,0"><Grid Margin="18,10"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NowColumn" Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="VolumeColumn" Width="180"/></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="CoverColumn" Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="NowArtBorder" CornerRadius="8" Background="#242424" Width="58" Height="58" HorizontalAlignment="Left"><Grid><TextBlock Text="♫" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/><Image x:Name="NowArt" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock x:Name="NowTitle" Text="Nothing playing" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowArtist" Text="Make yourself at home." Foreground="#A7A7A7" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="Shuffle" Content="⇄" ToolTip="Shuffle off" Background="Transparent" Padding="9,6"/><Button x:Name="Previous" Content="❮" Background="Transparent" Padding="9,6"/><Button x:Name="PlayPause" Content="▶" Background="#343434" Padding="18,7"/><Button x:Name="Next" Content="❯" Background="Transparent" Padding="9,6"/><Button x:Name="Repeat" Content="↻" ToolTip="Repeat off" Background="Transparent" Padding="9,6"/></StackPanel><DockPanel Margin="0,5,0,0"><TextBlock x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="#A7A7A7" Width="36"/><TextBlock x:Name="Duration" DockPanel.Dock="Right" Text="0:00" FontSize="10" Foreground="#A7A7A7" Width="36" TextAlignment="Right"/><Slider x:Name="Seek" Width="180" Minimum="0" Maximum="1" VerticalAlignment="Center"/></DockPanel></StackPanel><StackPanel x:Name="VolumePanel" Grid.Column="2" VerticalAlignment="Center" Margin="22,0,0,0"><TextBlock Text="VOLUME" FontSize="9" Foreground="#969696" Margin="0,0,0,10"/><Slider x:Name="Volume" Minimum="0" Maximum="1" Value="0.7"/><Button x:Name="TrackArt" Content="Track artwork" Background="Transparent" FontSize="10" Padding="3"/></StackPanel></Grid></Border>
 </Grid>
</Window>



